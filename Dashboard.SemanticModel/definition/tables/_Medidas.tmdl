table _Medidas
	lineageTag: b88a0405-04df-4eda-b64f-e4cd2b9201d5

	/// Quantidade total de inscrições, inclui apenas inscrições finalizadas.
	measure QTD_Inscricoes_Reais = DISTINCTCOUNT(conclusoes[ID_INSCRICAO])
		formatString: 0
		displayFolder: Quantidades
		lineageTag: f9079bd7-a9c4-421d-9a9f-66c5aa29f379

	/// Valor total em reais que entrou das inscrições (compreende apenas valores de inscrições concluídas)
	measure VLR_Inscricoes =
			CALCULATE(
			    SUM(inscricoes_marketing[PRECO_PAGO]),
			    FILTER(
			        inscricoes_marketing,
			        CONTAINS(
			            conclusoes,
			            conclusoes[ID_INSCRICAO],
			            inscricoes_marketing[ID_INSCRICAO]
			        )
			    )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Valores
		lineageTag: cc9d4a9c-9e72-4ae2-bfc3-483a4dabcfa3

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Quantidade total de inscrições, inclui finalizadas e não finalizadas.
	measure QTD_Inscricoes = DISTINCTCOUNT(inscricoes_marketing[ID_INSCRICAO])
		formatString: 0
		displayFolder: Quantidades
		lineageTag: 6ec681bc-36cb-4a53-9d21-fb76bbf36c02

	/// Taxa (percentual) de inscrições que foram devidamente concluídas
	measure Taxa_Conclusao = DIVIDE([QTD_Inscricoes_Reais], [QTD_Inscricoes], 0)
		formatString: 0%;-0%;0%
		displayFolder: Taxas
		lineageTag: aaeb4317-fa4a-433e-a141-5cef1dea3e84

	/// Média de quanto cada inscrição gerou de receita
	measure Ticket_Medio = DIVIDE([VLR_Inscricoes], [QTD_Inscricoes_Reais], 0)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Valores
		lineageTag: 5b3627ce-b89d-48c1-bc15-11a5d4db6f58

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Receita gerada desde o início do mês até a data atual.
	/// 
	/// DATESMTD retorna todas as datas desde o início do mês até a data máxima no contexto atual do filtro
	measure Receita_MTD =
			CALCULATE(
			    [VLR_Inscricoes],
			    DATESMTD(inscricoes_marketing[DATA_INSCRICAO])
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Valores
		lineageTag: 498c1973-534e-4393-ad44-dcc194fb3fe3

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Top_Categori_Curso =
			RANKX(
			    ALLSELECTED(cursos[CATEGORIA_CURSO]),
			    [VLR_Inscricoes],,DESC
			)
		formatString: 0
		lineageTag: 84b612c9-9d71-4636-ad01-8fbc399ac984

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

